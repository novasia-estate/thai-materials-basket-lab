      "id": "Kclp",
      "code_hash": "a0ff35ec7744ca88f7b8e3616a65fecc",
      "outputs": [
        {
          "type": "data",
          "data": {
            "text/markdown": "<span class=\"markdown prose dark:prose-invert contents\"><h2 id=\"calculation-and-interpretation\">Calculation and interpretation</h2>\n<span class=\"paragraph\">Each row contributes its normalised base-period cost share times the published\npercentage change for its material category. Summing signed contributions gives\nthe change of the modelled materials basket. Setting two category weights to zero\ndistributes the remaining share across the other categories.</span>\n<span class=\"paragraph\">The official index is shown as a separately published reference. It covers materials\ntraded in 20 provinces; the scenario weights are illustrative. Use quantities,\nsupplier quotes, labour, tax, lead times and a defined contract price date for an\nactual cost estimate. The year-to-date comparison uses the publisher's two period\naverages. It is a separate lens from the October and September point comparisons.</span>\n<span class=\"paragraph\"><a href=\"https://uploads.tpso.go.th/editor/pdf/1793934481_51742b5d42193db36f37.pdf\" rel=\"noopener noreferrer\" target=\"_blank\">TPSO October 2026 release and statistical table</a> \u00b7\n<a href=\"https://index.tpso.go.th/materials-price-index\" rel=\"noopener noreferrer\" target=\"_blank\">CMI data portal</a></span></span>"
          }
        }
      ],
      "console": []
    }
  ]
